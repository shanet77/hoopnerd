steam2.example.com {
	import security_headers
	root * /srv/sites/steam2.example.com
	log {
		output file /var/log/caddy/steam2-access.log {
			roll_size 50MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 32
				}
			}
		}
	}
	@stats path /stats.html /stats.html.gz /stats.json
	handle @stats {
		basic_auth {
			stats $2a$14$wn/V/4ZI/2PMiqULiE6WMOuIjfQ5B2PAd4pxQII1PMSEZ59pYWiIO
		}
		file_server
	}
	handle {
		file_server
	}
}
