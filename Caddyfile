{
	# Set this to a monitored inbox before production launch.
	# email you@hoopnerd.xyz
}

# Shared security headers applied by every site below.
(security_headers) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}
}

# Per-site blocks live in caddy/sites/*.caddy (one file per site).
# Mounted at /etc/caddy/sites inside the container — see
# quadlet/prod/hoopnerd-caddy.container.
import sites/*.caddy
