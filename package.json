{
  "name": "with-docker",
  "version": "0.11.0-alpha.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "oxlint .",
    "test": "turbo run test",
    "test:unit": "turbo run test -- unit --passWithNoTests",
    "test:integration": "turbo run test -- integration",
    "test:contract": "turbo run test -- contract",
    "test:coverage": "turbo run test -- --coverage"
  },
  "devDependencies": {
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.10"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=7.0.0"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a"
}
