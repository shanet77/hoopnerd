[Unit]
Description=HoopNerd Dev Database Seed (one-shot)
Requires=hn-dev-postgres.service
After=hn-dev-postgres.service

[Container]
Image=localhost/hoopnerd-db-seed-dev:local
ContainerName=hoopnerd-db-seed-dev

# Uses "postgres" hostname (matches NetworkAlias on postgres container)
Environment=DB_HOST=postgres
Environment=DB_NAME=connectaball_dev
Environment=DB_USER=postgres
Environment=DB_PASSWORD=postgres

Volume=/home/USER/project/hoopnerd/datasets:/app/datasets:ro

Network=hn-dev

[Service]
Type=oneshot
RemainAfterExit=no

[Install]
WantedBy=default.target
