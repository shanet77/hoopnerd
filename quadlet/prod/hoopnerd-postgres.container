[Unit]
Description=HoopNerd PostgreSQL 18
After=network-online.target

[Container]
Image=docker.io/library/postgres:18-alpine
ContainerName=hoopnerd-postgres

EnvironmentFile=/home/USER/project/hoopnerd/.env.prod

# postgres 18+ expects mount at /var/lib/postgresql, NOT /var/lib/postgresql/data
Volume=hoopnerd-postgres-data:/var/lib/postgresql

Network=hoopnerd-internal
PodmanArgs=--network-alias=postgres

PodmanArgs=--security-opt=no-new-privileges:true
PodmanArgs=--init

# Health check values must match POSTGRES_USER / POSTGRES_DB in .env.prod
HealthCmd=/bin/sh -c "pg_isready -U hoopnerd -d hoopnerd"
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always

[Install]
WantedBy=default.target
