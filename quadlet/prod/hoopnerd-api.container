[Unit]
Description=HoopNerd API (Express)
Requires=hoopnerd-postgres.service
After=hoopnerd-postgres.service network-online.target

[Container]
Image=zot.example.com/namespace/hoopnerd-api:main-latest
ContainerName=hoopnerd-api

EnvironmentFile=/home/deployer/project/hoopnerd/.env.prod

Environment=NODE_ENV=production
Environment=PORT=3001

Volume=/home/deployer/project/hoopnerd/datasets:/app/datasets:ro

Network=hoopnerd-edge
Network=hoopnerd-internal
PodmanArgs=--network-alias=api

PodmanArgs=--security-opt=no-new-privileges:true
PodmanArgs=--cap-drop=ALL
PodmanArgs=--read-only
PodmanArgs=--tmpfs=/tmp
PodmanArgs=--init

[Service]
Restart=always

[Install]
WantedBy=default.target
