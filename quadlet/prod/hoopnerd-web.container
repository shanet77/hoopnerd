[Unit]
Description=HoopNerd Web (Next.js)
Requires=hoopnerd-api.service
After=hoopnerd-api.service network-online.target

[Container]
Image=localhost/hoopnerd-web:main-latest
Pull=never
ContainerName=hoopnerd-web

EnvironmentFile=/home/deployer/project/hoopnerd/.env.prod

Environment=NODE_ENV=production
Environment=PORT=3000

Network=hoopnerd-edge
PodmanArgs=--network-alias=web

PodmanArgs=--security-opt=no-new-privileges:true
PodmanArgs=--cap-drop=ALL
PodmanArgs=--read-only
PodmanArgs=--tmpfs=/tmp
PodmanArgs=--tmpfs=/apps/web/.next/cache
PodmanArgs=--init

[Service]
Restart=always

[Install]
WantedBy=default.target
