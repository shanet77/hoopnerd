[Unit]
Description=HoopNerd Caddy Reverse Proxy
Requires=hoopnerd-web.service hoopnerd-api.service
After=hoopnerd-web.service hoopnerd-api.service network-online.target

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=hoopnerd-caddy

PublishPort=80:80
PublishPort=443:443

# Main Caddyfile (globals + shared snippets + import of sites/*.caddy)
Volume=/home/deployer/project/hoopnerd/Caddyfile:/etc/caddy/Caddyfile:ro
# Per-site blocks: add a new file under caddy/sites/ for each future site.
Volume=/home/deployer/project/hoopnerd/caddy/sites:/etc/caddy/sites:ro
# All static site roots in one mount so new sites need no quadlet change.
Volume=/home/deployer/sites:/srv/sites:ro
# Overlay the steam2 depots dataset onto the steam2 site tree
# (must come after the parent /srv/sites mount).
Volume=/home/deployer/sites/steam2-data/depots:/srv/sites/steam2.example.com/data/depots:ro
# Overlay the personal-site deploys (Forgejo uploads as deployer) onto the
# path the example-site.caddy site block serves.
# (must come after the parent /srv/sites mount).
Volume=/home/deployer/sites/personal-site:/srv/sites/personal-site:ro
Volume=hoopnerd-caddy-data:/data
Volume=/home/deployer/logs/caddy:/var/log/caddy
Volume=hoopnerd-caddy-config:/config

Network=hoopnerd-edge

PodmanArgs=--security-opt=no-new-privileges:true
PodmanArgs=--cap-drop=ALL
PodmanArgs=--cap-add=NET_BIND_SERVICE
PodmanArgs=--read-only
PodmanArgs=--tmpfs=/tmp
PodmanArgs=--init

[Service]
Restart=always

[Install]
WantedBy=default.target
