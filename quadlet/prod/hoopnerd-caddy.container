[Unit]
Description=HoopNerd Caddy Reverse Proxy
Requires=hoopnerd-web.service hoopnerd-api.service
After=hoopnerd-web.service hoopnerd-api.service network-online.target

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=hoopnerd-caddy

PublishPort=80:80
PublishPort=443:443

Volume=/home/USER/project/hoopnerd/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=hoopnerd-caddy-data:/data
Volume=hoopnerd-caddy-config:/config

Network=hoopnerd-edge

SecurityOpt=no-new-privileges:true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
ReadOnly=true
Tmpfs=/tmp
RunInit=yes

[Service]
Restart=always

[Install]
WantedBy=default.target
