[Unit]
Description=HoopNerd Database Seed (one-shot)
Requires=hoopnerd-postgres.service
After=hoopnerd-postgres.service

[Container]
Image=localhost/hoopnerd-db-seed:local
ContainerName=hoopnerd-db-seed

EnvironmentFile=/home/USER/project/hoopnerd/.env.prod
Environment=NODE_ENV=production

Volume=/home/USER/project/hoopnerd/datasets:/app/datasets:ro

Network=hoopnerd-internal

SecurityOpt=no-new-privileges:true
DropCapability=ALL
ReadOnly=true
Tmpfs=/tmp
RunInit=yes

[Service]
Type=oneshot
RemainAfterExit=no

[Install]
WantedBy=default.target
