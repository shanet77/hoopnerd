FROM node:24-alpine

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install pnpm (pinned to 10.30.1, same toolchain as apps/api + apps/web Dockerfiles:
# bare `npm i -g pnpm` pulls latest v11 which is a broken release, and latest
# pnpm@10 errors on this repo's pnpm-workspace.yaml format)
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

# Copy the entire project
COPY . .

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build the database package and its workspace dependencies.
# The trailing "..." is required: @repo/types resolves via its package.json
# "types": "./dist/index.d.ts", so it must be compiled before @repo/database.
RUN pnpm --filter "@repo/database..." build

WORKDIR /app/packages/database

# Run the seed script (which now includes migrations)
CMD ["pnpm", "node", "dist/seed.js"]
