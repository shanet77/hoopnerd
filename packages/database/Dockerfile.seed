FROM node:24-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=/pnpm:$PATH
RUN corepack enable

FROM base AS prepare
WORKDIR /app
COPY . .
RUN pnpm --filter "@repo/database..." build \
    && pnpm --filter "@repo/database" deploy --prod --legacy /out

FROM base AS runner
WORKDIR /app/packages/database
RUN addgroup --system --gid 1001 seed && adduser --system --uid 1001 seed
USER seed
COPY --from=prepare --chown=seed:seed /out ./

CMD ["node", "dist/seed.js"]
