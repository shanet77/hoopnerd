FROM node:24-alpine

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# corepack picks up the pinned pnpm version from packageManager in package.json
RUN corepack enable

# Copy the entire project
COPY . .

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build the database package and its workspace dependencies.
# The trailing "..." is required: @repo/types resolves via its package.json
# "types": "./dist/index.d.ts", so it must be compiled before @repo/database.
RUN pnpm --filter "@repo/database..." build

WORKDIR /app/packages/database

# Run the seed script (which now includes migrations)
CMD ["pnpm", "node", "dist/seed.js"]
