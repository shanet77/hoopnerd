{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc -w",
    "seed": "pnpm run build && node dist/seed.js",
    "ingest:transactions": "pnpm run build && node dist/ingestTransactions.js --season 2026",
    "migrate": "node src/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/types": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^25.9.6",
    "@types/pg": "^8.23.1",
    "csv-parser": "^3.2.1",
    "typescript": "6.0.2",
    "vitest": "^4.1.11"
  }
}
