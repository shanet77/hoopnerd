{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc -w",
    "seed": "pnpm run build && node dist/seed.js",
    "ingest:transactions": "pnpm run build && node dist/ingestTransactions.js --season 2026",
    "ingest:offseason": "pnpm run build && node dist/ingestTransactions.js --offseason --season 2027",
    "migrate": "node src/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/types": "workspace:*",
    "csv-parser": "^3.2.1",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
