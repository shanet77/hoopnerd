{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "globalEnv": [
    "SOCKET_SESSION_SECRET",
    "TURN_TIMEOUT_MS",
    "DISCONNECT_GRACE_MS",
    "ENABLE_CPU_MODE"
  ],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/dist/**"],
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_HOST", "NEXT_PUBLIC_UMAMI_WEBSITE_ID"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DB_HOST",
        "DB_PORT",
        "DB_NAME",
        "DB_USER",
        "DB_PASSWORD",
        "NODE_ENV",
        "PORT",
        "CORS_ORIGIN",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_API_HOST",
        "NEXT_PUBLIC_UMAMI_WEBSITE_ID"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
